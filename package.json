{
  "name": "edly-solution-estimator",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Edly solution estimator — practice/platform catalogs, estimations, rate cards and delivery planning. Persists to a spreadsheet in your own account.",
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run typecheck && bun run lint && bun run test",
    "store:probe": "bun run scripts/store.ts probe",
    "store:discover": "bun run scripts/store.ts discover",
    "state:dump": "bun run scripts/store.ts dump",
    "state:seed": "bun run scripts/store.ts seed"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
