{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "functions": {
    "api/state.ts": {
      "maxDuration": 15
    },
    "api/catalog.ts": {
      "maxDuration": 15
    },
    "api/tender.ts": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/catalog-source.xlsx",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}
