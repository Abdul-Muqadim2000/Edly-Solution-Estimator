{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": {
      "runtime": "nodejs22.x",
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/catalog-source.xlsx",
      "headers": [
        { "key": "cache-control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "cache-control", "value": "no-store" }
      ]
    }
  ]
}
