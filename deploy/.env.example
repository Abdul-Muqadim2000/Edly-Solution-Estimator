# ─────────────────────────────────────────────────────────────────────────────
# Pick ONE store. Unset, the app auto-detects from whichever keys are present,
# and falls back to a local file for `bun dev`.
#   graph | gsheet | dropbox | blob | local
# ─────────────────────────────────────────────────────────────────────────────
EDLY_STORE=

# ── OneDrive / SharePoint (a real .xlsx in your Microsoft 365 drive) ─────────
# Azure portal → App registrations → New registration
#   API permissions → Microsoft Graph → Application → Files.ReadWrite.All → Grant admin consent
#   Certificates & secrets → New client secret
# Then: bun run store:discover  to find MS_DRIVE_ID
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_DRIVE_ID=
MS_FILE_PATH=Edly/edly-state.xlsx

# ── Google Sheets (live rows in a spreadsheet you own) ───────────────────────
# Google Cloud → enable Sheets API → service account → JSON key
# Then SHARE the spreadsheet with GOOGLE_SA_EMAIL as Editor
GOOGLE_SHEET_ID=
GOOGLE_SA_EMAIL=
GOOGLE_SA_KEY=

# ── Dropbox ─────────────────────────────────────────────────────────────────
DROPBOX_PATH=/Edly/edly-state.xlsx
DROPBOX_TOKEN=
# Long-lived alternative (preferred for a deployment):
DROPBOX_REFRESH_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# ── Vercel Blob (no account of your own needed) ──────────────────────────────
# Injected automatically when you connect a Blob store in the Vercel dashboard
BLOB_READ_WRITE_TOKEN=
EDLY_STATE_BLOB=edly-state.xlsx

# ── Local dev ───────────────────────────────────────────────────────────────
EDLY_STATE_PATH=./data/edly-state.xlsx
PORT=3000

# ── Catalog (read-only) ─────────────────────────────────────────────────────
# Leave unset to use public/catalog-source.xlsx. Point it at a hosted copy to
# update the catalog without redeploying.
EDLY_CATALOG_URL=
