# ─────────────────────────────────────────────────────────────────────────────
# Pick ONE store. Unset, the app auto-detects from whichever keys are present
# and falls back to a local file for development.
#   graph | gsheet | dropbox | blob | local
# ─────────────────────────────────────────────────────────────────────────────
EDLY_STORE=

# ── OneDrive / SharePoint (a real .xlsx in your Microsoft 365 drive) ─────────
# Azure portal → App registrations → New registration
#   API permissions → Microsoft Graph → Application → Files.ReadWrite.All → Grant admin consent
#   Certificates & secrets → New client secret
# Then: bun run store:discover  to find MS_DRIVE_ID
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_DRIVE_ID=
MS_FILE_PATH=Edly/edly-state.xlsx

# ── Google Sheets (live rows in a spreadsheet you own) ───────────────────────
# Google Cloud → enable Sheets API → service account → JSON key
# Then SHARE the spreadsheet with GOOGLE_SA_EMAIL as Editor
GOOGLE_SHEET_ID=
GOOGLE_SA_EMAIL=
GOOGLE_SA_KEY=

# ── Dropbox ─────────────────────────────────────────────────────────────────
DROPBOX_PATH=/Edly/edly-state.xlsx
DROPBOX_REFRESH_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Short-lived alternative from the app console:
DROPBOX_TOKEN=

# ── Vercel Blob (no account of your own needed) ──────────────────────────────
# Injected automatically when you connect a Blob store in the Vercel dashboard
BLOB_READ_WRITE_TOKEN=
EDLY_STATE_BLOB=edly-state.xlsx

# ── Local development ───────────────────────────────────────────────────────
EDLY_STATE_PATH=./data/edly-state.xlsx
PORT=3000

# ── Catalog (read-only at runtime) ──────────────────────────────────────────
# Leave unset to use public/catalog-source.xlsx. Point it at a hosted copy to
# update the catalog without redeploying.
EDLY_CATALOG_URL=

# ── Tender intake (the AI that reads RFPs) ──────────────────────────────────
# console.anthropic.com → API keys. Server-side only: never exposed to the
# browser. Without it the app works as before and "Start from a tender" says
# the AI is not set up. Tender files are sent to Anthropic's API under its
# commercial terms; see DEFERRED.md on zero data retention before live use.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5 (Opus 5.5), which costs less per token than Opus 5
# and much less to read from cache. Set claude-opus-5 if your key cannot use it.
# Change it here rather than in code.
EDLY_AI_MODEL=
# Retries on 429 and 5xx before a call is reported as failed. Default 2.
EDLY_AI_RETRIES=
# How long one AI call may run before the function gives up, in ms. Default
# 270000, just under the 300 s maxDuration in vercel.json; raise both together.
EDLY_AI_DEADLINE_MS=
# How hard the model thinks: low, medium, high, xhigh or max. Unset means
# medium, which is sent on every call rather than left to the API, whose default
# differs by model. Thinking is billed as output, the dearest tokens, so low is
# the next saving to try, once a real tender has been read at both levels and
# compared (DEFERRED.md 8). Applies to every call alike.
EDLY_AI_EFFORT=
# Dollars the AI may spend on one tender before the screen asks whether to go
# on, and how much more each "Continue" allows. Default 4. Kept on each tender
# when it is created, so a change applies to new tenders only. It is a check in
# the browser, not a cap: also set a monthly spend limit on the Anthropic
# Console workspace that owns the key (DEFERRED.md 11).
EDLY_AI_TENDER_LIMIT_USD=
